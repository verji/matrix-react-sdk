/* VERJI: "Add existing Guest Organization" and "Add existing room" (verji/verji-src#2117). They
   reuse the AddExistingToSpace layout; these are only what it lacks: a description, a hint under a
   room's name, a button per row in place of a checkbox, and a message state. */
.mx_VerjiAddExistingToOrgUnitDialog {
    .mx_VerjiAddExistingToOrgUnit_description {
        color: $secondary-content;
        font-size: $font-12px;
        line-height: $font-15px;
        margin: 0 0 12px 0;
    }

    .mx_VerjiAddExistingToOrgUnit_entry {
        align-items: center;

        .mx_AddExistingToSpace_entry_name {
            white-space: normal;
        }
    }

    .mx_VerjiAddExistingToOrgUnit_hint {
        color: $secondary-content;
        font-size: $font-12px;
        line-height: $font-15px;
    }

    .mx_VerjiAddExistingToOrgUnit_add {
        flex-shrink: 0;
    }

    .mx_VerjiAddExistingToOrgUnit_message {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 12px;
    }

    .mx_VerjiAddExistingToOrgUnit_error {
        color: $alert;
    }

    .mx_AddExistingToSpace_footer .mx_AccessibleButton + .mx_AccessibleButton {
        margin-left: 8px;
    }
}
